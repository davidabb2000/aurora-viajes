ENTORNO=desarrollo
# En true publica /docs y registra cada consulta SQL con sus datos: solo para desarrollo, nunca en produccion.
DEPURACION=false
ORIGENES_PERMITIDOS=["http://localhost:5173","http://127.0.0.1:5173"]
MOTOR_BD=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aurora_viajes
MYSQL_CHARSET=utf8mb4
MYSQL_DRIVER=aiomysql
# URL completa del MySQL gestionado (Aiven, Clever Cloud...). Tiene prioridad
# sobre las MYSQL_*. Si trae ssl-mode, el backend activa TLS y lo retira.
DATABASE_URL=
# Fuerza TLS aunque la URL no lo pida. MYSQL_SSL_CA apunta a un certificado
# de CA para ademas verificarlo.
MYSQL_SSL=false
MYSQL_SSL_CA=
SECRET_KEY=reemplazar-por-una-clave-generada
ALGORITMO_JWT=HS256
MINUTOS_EXPIRACION_TOKEN=60
# El administrador se crea una sola vez, con esta clave. Elige una propia y larga.
# Si dejas Admin123! (la del ejemplo), la cuenta obliga a cambiarla en el primer acceso.
ADMIN_EMAIL=admin@auroraviajes.com
ADMIN_PASSWORD=Admin123!
# En true, el siguiente arranque vuelve a fijar la clave del administrador a ADMIN_PASSWORD
# (para recuperar el acceso). Vuelve a ponerlo en false despues.
ADMIN_RESTABLECER_CONTRASENA=false
# Cuantos proxies de confianza hay delante de la app (Railway = 1; en local, 0). De ahi sale la IP
# real del cliente para los limites de intentos: lo que el cliente escriba en X-Forwarded-For no cuenta.
PROXIES_DE_CONFIANZA=1
# Tope, en bytes, del cuerpo de una peticion (la API solo recibe JSON pequeno).
TAMANO_MAXIMO_CUERPO=1000000
PROVEEDOR_IA_API_KEY=
PROVEEDOR_IA_URL=https://api.groq.com/openai/v1/chat/completions
PROVEEDOR_IA_MODELO=llama-3.1-8b-instant
STRIPE_SECRET_KEY=
# Secreto de firma del webhook (Stripe > Developers > Webhooks > tu endpoint). Sin el, el webhook devuelve 503.
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=noreply@auroraviajes.com
SMTP_USE_TLS=true
