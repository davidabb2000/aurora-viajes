{
  "info": {
    "name": "Aurora Viajes - Quinto avance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8001/api" },
    { "key": "token", "value": "" },
    { "key": "ventaId", "value": "1" },
    { "key": "facturaId", "value": "1" },
    { "key": "pqrId", "value": "1" },
    {
      "key": "adminEmail",
      "value": "admin@auroraviajes.com"
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{adminEmail}}\",\n  \"contrasena\": \"{{adminPassword}}\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Registrar venta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"tipo\": \"servicio\", \"id\": 1, \"cantidad\": 1 }],\n  \"descuento\": 0,\n  \"impuesto_porcentaje\": 19\n}" },
        "url": "{{baseUrl}}/ventas"
      }
    },
    {
      "name": "Historial de ventas filtrado",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/ventas?desde=2026-01-01&hasta=2026-12-31&estado=completada" }
    },
    {
      "name": "Reporte PDF",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/reportes/ventas?fecha=2026-09-16&formato=pdf" }
    },
    {
      "name": "Reporte Excel",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/reportes/ventas?fecha=2026-09-16&formato=xlsx" }
    },
    {
      "name": "Consultar facturas",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/facturas?desde=2026-01-01&hasta=2026-12-31" }
    },
    {
      "name": "Descargar factura PDF",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/facturas/{{facturaId}}/pdf" }
    },
    {
      "name": "Dashboard filtrado",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/estadisticas?periodo=mes&desde=2026-01-01&hasta=2026-12-31" }
    },
    {
      "name": "Registrar PQR",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"tipo\": \"peticion\",\n  \"asunto\": \"Consulta de reserva\",\n  \"descripcion\": \"Necesito información sobre mi reserva.\"\n}" }, "url": "{{baseUrl}}/pqr" }
    },
    {
      "name": "Gestionar PQR",
      "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"estado\": \"respondida\",\n  \"respuesta\": \"Tu solicitud fue atendida.\"\n}" }, "url": "{{baseUrl}}/pqr/{{pqrId}}" }
    },
    {
      "name": "Chatbot IA",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"mensaje\": \"¿Qué servicios ofrecen?\"\n}" }, "url": "{{baseUrl}}/chatbot" }
    }
  ]
}
