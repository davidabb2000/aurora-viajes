{
  "info": {
    "_postman_id": "8f2b6a1e-4c7d-4a3b-9e21-aurora-viajes-fastapi",
    "name": "Aurora Viajes API (FastAPI)",
    "description": "Colección de evidencia para probar la API FastAPI de Aurora Viajes: salud, autenticación JWT, usuarios, productos, servicios, reservas y contacto. Ejecuta primero 'Login administrador' para guardar el token automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "usuario_id", "value": "1", "type": "string" },
    { "key": "producto_id", "value": "1", "type": "string" },
    { "key": "servicio_id", "value": "1", "type": "string" },
    { "key": "reserva_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "GET Estado de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST Registro de cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Gómez\",\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"1000000001\",\n  \"direccion\": \"Calle 10 #20-30\",\n  \"telefono\": \"3001234567\",\n  \"correo\": \"ana.gomez@example.com\",\n  \"contrasena\": \"ClaveSegura1!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/usuarios/registro", "host": ["{{base_url}}"], "path": ["usuarios", "registro"] }
          }
        },
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const datos = pm.response.json();",
                  "    pm.collectionVariables.set('token', datos.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@auroraviajes.com\",\n  \"contrasena\": \"Admin123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "POST Solicitar recuperación de contraseña",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"ana.gomez@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/recuperar", "host": ["{{base_url}}"], "path": ["auth", "recuperar"] }
          }
        },
        {
          "name": "POST Restablecer contraseña",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"ana.gomez@example.com\",\n  \"token\": \"pega-aqui-el-token-de-recuperar\",\n  \"nuevaContrasena\": \"NuevaClaveSegura2!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/auth/restablecer", "host": ["{{base_url}}"], "path": ["auth", "restablecer"] }
          }
        }
      ]
    },
